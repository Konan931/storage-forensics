# DWP Storage Forensics: public source only, never local machine evidence.
.DS_Store
.AppleDouble
.LSOverride

# Credentials and machine-local configuration.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.mobileprovision

# Reports and captures. Diagnostics can expose paths and device identifiers.
/reports/
/evidence/
/diagnostics/
/local/
*.log
*.trace
*.pcap
*.pcapng
*.har
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.bak
*_raw.txt
*_diagnostic.txt

# Runtime artifacts and archive exports.
*.zip
*.tar
*.tgz
*.gz
*.tmp
*.swp
*.swo
.DS_Store?
__pycache__/
.pytest_cache/

# If a future UI is added, keep its generated dependencies out of Git.
node_modules/
.next/
dist/
coverage/
